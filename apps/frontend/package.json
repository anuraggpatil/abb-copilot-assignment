{
  "name": "alarm-copilot-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GUI for the alarm investigation copilot: question, attributed answer, live MCP execution trace.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
