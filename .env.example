# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.

# ---------------------------------------------------------------------------
# Alarm Management API simulator (the source system)
# ---------------------------------------------------------------------------
ALARM_API_HOST=0.0.0.0
ALARM_API_PORT=8000
ALARM_API_BASE_URL=http://localhost:8000
# Bearer token the simulator accepts and the connector sends. Demo value only.
ALARM_API_TOKEN=demo-token
ALARM_API_TIMEOUT_SECONDS=10
ALARM_API_MAX_RETRIES=3

# Deterministic seed for the generated alarm/asset dataset. Data is generated
# RELATIVE TO THE CURRENT DATE so "last 90 days" queries always return rows.
SEED_RANDOM_SEED=1729
# Must comfortably exceed the Postman collections' hard-coded window, which starts
# 2026-05-01 — 151 days before 2026-09-29. A shorter horizon leaves those requests
# returning empty and fails their assertions. 400 also gives year-over-year trends.
SEED_DAYS_OF_HISTORY=400

# ---------------------------------------------------------------------------
# MCP server
# ---------------------------------------------------------------------------
MCP_TRANSPORT=streamable-http
MCP_SERVER_HOST=0.0.0.0
# 9100, not the 9000 the assignment's compose file names: on a corporate macOS image 9000 is
# commonly already held (verified on this machine — Microsoft OneDrive/Teams bind
# 127.0.0.1:9000), and the failure is an opaque "address already in use" followed by an MCP
# content-type error from the smoke script. If you move it again, move all three of PORT/URL
# and the --port flag together, or `make mcp` binds one port while `make mcp-smoke` dials
# another.
MCP_SERVER_PORT=9100
# Path the server binds, kept separate from the URL the client dials. Must be set under this
# name: a bare `PATH` is the shell's, and the server would advertise that as its endpoint.
MCP_SERVER_PATH=/mcp
MCP_SERVER_URL=http://localhost:9100/mcp
MCP_CLIENT_ID=alarm-copilot
MCP_TOOL_TIMEOUT_SECONDS=30
# Ceiling on rows any single tool returns, below the API's own cap of 500: these payloads go
# into a model's context window.
MCP_MAX_ROWS=100

# ---------------------------------------------------------------------------
# LLM provider (swappable). `gemini` | `scripted`
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_MODEL=gemini-flash-latest
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=90
# Retries on 429 and 503. The free tier answers "high demand" under load often enough
# that one transient refusal must not fail an operator's question.
LLM_MAX_RETRIES=2
# Google AI Studio API key, from https://aistudio.google.com/apikey
# REPLACE — do not commit the real value. Sent as an `x-goog-api-key` header and never
# in a URL, so it cannot be captured by a proxy log or an exception repr.
GEMINI_API_KEY=replace-me
# Whether to advertise tools natively instead of using the planner's JSON protocol.
# Gemini documents function calling, so this is on. Check with `python scripts/probe_llm.py`.
LLM_NATIVE_TOOLS=true
# Output tokens the 2.5-series models may spend on hidden reasoning before writing anything.
# Leave empty for Gemini's own default. Set to 0 if a reply ever arrives empty with
# `finishReason: MAX_TOKENS` — that is thinking having eaten the whole budget.
GEMINI_THINKING_BUDGET=

# ---------------------------------------------------------------------------
# RAG
# ---------------------------------------------------------------------------
RAG_DOCUMENTS_DIR=rag/documents
RAG_QDRANT_PATH=.qdrant
RAG_COLLECTION=alarm_procedures
# Embedding backend. `fastembed` runs bge-small-en-v1.5 via ONNX (~50MB, no torch).
# `hash` is a deterministic offline stand-in used by CI and unit tests so the suite
# never downloads model weights.
RAG_EMBEDDER=fastembed
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Load the weights from a local directory instead of downloading them. Leave empty on a
# normal network. Required where HuggingFace is blocked or TLS is intercepted (Zscaler's
# root CA is rejected by OpenSSL 3, so every Python HTTPS request fails): run
# `make fetch-model`, then set this to the path it prints.
RAG_EMBED_MODEL_PATH=
# Soft token budget per chunk. Soft because the section is the unit of citation: sections are
# never merged, and a table or numbered step list is never split, so a few chunks exceed this
# deliberately. `make ingest` lists which ones and why.
RAG_CHUNK_SIZE=380
# Below this, a trailing chunk is folded back into the one it was split from.
RAG_CHUNK_MIN_TOKENS=40
# Sentences of the previous chunk repeated at the start of the next, when one section splits
# across several chunks. Sentences rather than tokens, so an overlap is never half a sentence.
RAG_CHUNK_OVERLAP_SENTENCES=1

RAG_TOP_K=5
# Candidates taken from each retriever before fusion. Wider than TOP_K on purpose:
# reciprocal-rank fusion can only promote a chunk that at least one retriever returned.
RAG_CANDIDATES=20
# Floor on the best dense cosine similarity. Below it, the copilot reports "insufficient
# documented evidence" instead of answering from weak matches.
#
# NOT a threshold on the fused RRF score, which cannot work: RRF encodes only rank, so the
# top hit scores the same whether its cosine was 0.85 or 0.41 and no threshold on it can ever
# abstain. Measured on this corpus with bge-small and asserted in test_retrieval_semantic.py:
# on-topic 0.663-0.820, off-topic 0.406-0.535. 0.60 is the midpoint of the gap. The margin is
# narrow, and cosine cannot tell "topically similar" from "applicable" — a gas-turbine question
# scores 0.688 against the pump manual. Calibrated to this model; RAG_EMBEDDER=hash has an
# overlapping distribution that no threshold separates.
RAG_MIN_RELEVANCE=0.60
# The k in RRF's 1/(k + rank): how much rank within a list counts against appearing in both.
# NOT 60 — that was tuned on candidate lists 1000 deep, and at depth 20 it flattens rank
# almost entirely, reducing RRF to counting retrievers. 2 is 60 scaled to this depth. Raise it
# if RAG_CANDIDATES grows a lot. See rag/config.py for the measurements.
RAG_RRF_K=2

# ---------------------------------------------------------------------------
# Copilot backend
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
BACKEND_CORS_ORIGINS=http://localhost:5173
ORCHESTRATOR_MAX_STEPS=8

# How long a single MCP tool call may take before it is reported as a timeout and the
# investigation continues without it.
MCP_TOOL_TIMEOUT_SECONDS=30

# Conversations kept in the in-memory trace store; the oldest is evicted. Traces are what
# GET /trace/{id} serves, so this is how far back the GUI can look — and a restart clears it.
TRACE_RETENTION=50

# Earlier turns of the same conversation the copilot is shown when answering a new question, so
# a follow-up ("and what about pump 102?") resolves against them. Every turn pays for this
# window in input tokens; set it to 1 to make each question independent again.
CONVERSATION_TURNS=4

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:8080
